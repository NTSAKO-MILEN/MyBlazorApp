@page "/"
@implements IDisposable
@using MyBlazorApp.Models
@using MyBlazorApp.Services
@inject EventService EventService

<PageTitle>Upcoming Events</PageTitle>

<main class="event-page">
    <section class="welcome-panel">
        <p class="eyebrow">EVENTEASE · YOUR LOCAL EVENT GUIDE</p>
        <h1>Discover Your Next Event</h1>
        <p class="welcome-copy">Find something inspiring, meet your community, and make your next day memorable.</p>
    </section>

    <section class="events-section" aria-labelledby="events-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">HAND-PICKED FOR YOU</p>
                <h2 id="events-heading">Upcoming events</h2>
            </div>
            <span class="event-count">@events.Count @(events.Count == 1 ? "event" : "events")</span>
        </div>

        @if (events.Count == 0)
        {
            <div class="empty-state">
                <h3>Nothing on the calendar just yet</h3>
                <p>Check back soon to discover new events in your community.</p>
            </div>
        }
        else
        {
            <div class="event-grid">
                @foreach (var eventItem in events)
                {
                    <article class="event-card" @key="eventItem.Id">
                        <div class="card-accent"></div>
                        <div class="event-card-content">
                            <p class="event-type">COMMUNITY EVENT</p>
                            <h3 class="event-name">@eventItem.Name</h3>
                            <p class="event-description">@eventItem.Description</p>

                            <div class="event-details">
                                <div class="detail-row">
                                    <span class="detail-icon" aria-hidden="true">⌖</span>
                                    <div>
                                        <span class="detail-label">VENUE</span>
                                        <span class="detail-value">@eventItem.Venue</span>
                                    </div>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-icon" aria-hidden="true">◷</span>
                                    <div>
                                        <span class="detail-label">DATE &amp; TIME</span>
                                        <span class="detail-value">@eventItem.DateTime.ToString("f")</span>
                                    </div>
                                </div>
                                <div class="attendee-summary">
                                    <span class="attendee-dot" aria-hidden="true"></span>
                                    <span><strong>@eventItem.RegisteredAttendees.Count</strong> registered @(eventItem.RegisteredAttendees.Count == 1 ? "attendee" : "attendees")</span>
                                </div>
                            </div>

                            <div class="registration">
                                <label for="@($"attendee-{eventItem.Id}")" class="form-label">Register your interest</label>
                                <input id="@($"attendee-{eventItem.Id}")"
                                       class="form-control attendee-input"
                                       placeholder="Enter your name"
                                       value="@attendeeNames[eventItem.Id]"
                                       @oninput="args => UpdateAttendeeName(eventItem.Id, args)" />
                                <button class="register-button"
                                        @onclick="() => RegisterForEvent(eventItem.Id)">
                                    Register for event <span aria-hidden="true">→</span>
                                </button>
                                @if (registrationMessages.TryGetValue(eventItem.Id, out var message))
                                {
                                    <p class="registration-message @(registrationSucceeded.GetValueOrDefault(eventItem.Id) ? "success" : "error")"
                                       role="@(registrationSucceeded.GetValueOrDefault(eventItem.Id) ? "status" : "alert")">
                                        @message
                                    </p>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</main>

<style>
    .event-page {
        min-height: 100%;
        margin: -1.1rem -1.5rem 0;
        padding: 2.5rem clamp(1.25rem, 4vw, 3.5rem) 3.5rem;
        background: #f4f7fb;
        color: #172b4d;
    }

    .welcome-panel {
        max-width: 820px;
        margin: 0 auto 2.75rem;
        padding: clamp(1.75rem, 5vw, 3.25rem);
        border: 1px solid #e2eaf5;
        border-radius: 20px;
        background: linear-gradient(115deg, #fff 45%, #edf5ff);
        box-shadow: 0 10px 30px rgba(27, 55, 92, 0.06);
    }

    .eyebrow {
        margin: 0 0 0.65rem;
        color: #3979c6;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.13em;
    }

    .welcome-panel h1 {
        margin: 0;
        color: #142b4d;
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 750;
        letter-spacing: -0.04em;
    }

    .welcome-copy {
        max-width: 570px;
        margin: 0.8rem 0 0;
        color: #61728a;
        font-size: 1.05rem;
        line-height: 1.65;
    }

    .events-section {
        max-width: 1180px;
        margin: 0 auto;
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .section-heading .eyebrow {
        margin-bottom: 0.25rem;
    }

    .section-heading h2 {
        margin: 0;
        color: #172b4d;
        font-size: 1.55rem;
        font-weight: 700;
        letter-spacing: -0.025em;
    }

    .event-count {
        padding: 0.4rem 0.75rem;
        border: 1px solid #dce8f7;
        border-radius: 999px;
        background: #fff;
        color: #48617f;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .event-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: 1.25rem;
    }

    .event-card {
        overflow: hidden;
        border: 1px solid #e4eaf2;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 22px rgba(27, 55, 92, 0.055);
        transition: transform 160ms ease, box-shadow 160ms ease;
    }

    .event-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 28px rgba(27, 55, 92, 0.1);
    }

    .card-accent {
        height: 5px;
        background: linear-gradient(90deg, #3478c7, #8ec5ff);
    }

    .event-card-content {
        padding: 1.35rem;
    }

    .event-type {
        margin: 0 0 0.55rem;
        color: #5182b9;
        font-size: 0.67rem;
        font-weight: 700;
        letter-spacing: 0.1em;
    }

    .event-name {
        margin: 0;
        color: #172b4d;
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: -0.02em;
    }

    .event-description {
        min-height: 2.9rem;
        margin: 0.55rem 0 1.1rem;
        color: #697a91;
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .event-details {
        display: grid;
        gap: 0.85rem;
        padding: 1rem 0;
        border-top: 1px solid #edf1f6;
        border-bottom: 1px solid #edf1f6;
    }

    .detail-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }

    .detail-icon {
        display: grid;
        width: 2rem;
        height: 2rem;
        flex: 0 0 2rem;
        place-items: center;
        border-radius: 9px;
        background: #edf5ff;
        color: #3478c7;
        font-size: 1.25rem;
    }

    .detail-row > div {
        display: grid;
        gap: 0.1rem;
    }

    .detail-label {
        color: #8290a3;
        font-size: 0.63rem;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    .detail-value {
        color: #263d5c;
        font-size: 0.87rem;
        font-weight: 550;
    }

    .attendee-summary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #65768d;
        font-size: 0.82rem;
    }

    .attendee-summary strong {
        color: #1b3557;
    }

    .attendee-dot {
        width: 0.48rem;
        height: 0.48rem;
        border-radius: 50%;
        background: #4a9be8;
    }

    .registration {
        padding-top: 1rem;
    }

    .registration .form-label {
        margin-bottom: 0.4rem;
        color: #314762;
        font-size: 0.82rem;
        font-weight: 650;
    }

    .attendee-input {
        min-height: 2.75rem;
        border-color: #d9e2ed;
        border-radius: 9px;
        color: #172b4d;
        font-size: 0.9rem;
    }

    .attendee-input:focus {
        border-color: #6da9e8;
        box-shadow: 0 0 0 0.2rem rgba(65, 133, 207, 0.15);
    }

    .register-button {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.65rem;
        padding: 0.7rem 0.9rem;
        border: 0;
        border-radius: 9px;
        background: #1c3b63;
        color: #fff;
        font-size: 0.88rem;
        font-weight: 650;
        transition: background 150ms ease;
    }

    .register-button:hover {
        background: #2e629d;
    }

    .register-button:focus-visible {
        outline: 3px solid #8ec5ff;
        outline-offset: 2px;
    }

    .registration-message {
        margin: 0.65rem 0 0;
        font-size: 0.82rem;
        line-height: 1.45;
    }

    .registration-message.success {
        color: #24764e;
    }

    .registration-message.error {
        color: #a53d48;
    }

    .empty-state {
        padding: 2.5rem 1.5rem;
        border: 1px dashed #cbd8e7;
        border-radius: 16px;
        background: #fff;
        text-align: center;
    }

    .empty-state h3 {
        margin: 0 0 0.45rem;
        color: #1b3557;
        font-size: 1.1rem;
    }

    .empty-state p {
        margin: 0;
        color: #697a91;
    }

    @@media (max-width: 575.98px) {
        .event-page {
            margin: -1.1rem -1rem 0;
            padding: 1.25rem 1rem 2rem;
        }

        .welcome-panel {
            margin-bottom: 2rem;
            border-radius: 15px;
        }

        .section-heading h2 {
            font-size: 1.35rem;
        }
    }
</style>

@code {
    private IReadOnlyList<Event> events = [];
    private readonly Dictionary<int, string> attendeeNames = [];
    private readonly Dictionary<int, string> registrationMessages = [];
    private readonly Dictionary<int, bool> registrationSucceeded = [];

    protected override void OnInitialized()
    {
        events = EventService.GetAllEvents();
        foreach (var eventItem in events)
        {
            attendeeNames[eventItem.Id] = string.Empty;
        }

        EventService.OnChange += HandleEventServiceChange;
    }

    private void RegisterForEvent(int eventId)
    {
        var attendeeName = attendeeNames[eventId];
        if (EventService.RegisterAttendee(eventId, attendeeName))
        {
            registrationMessages[eventId] = $"You are registered for {events.First(item => item.Id == eventId).Name}.";
            registrationSucceeded[eventId] = true;
            attendeeNames[eventId] = string.Empty;
        }
        else
        {
            registrationMessages[eventId] = "Please enter a name that is not already registered for this event.";
            registrationSucceeded[eventId] = false;
        }
    }

    private void UpdateAttendeeName(int eventId, ChangeEventArgs args)
    {
        attendeeNames[eventId] = args.Value?.ToString() ?? string.Empty;
    }

    private void HandleEventServiceChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EventService.OnChange -= HandleEventServiceChange;
    }
}
